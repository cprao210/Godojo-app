{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDir": "..",
    "outDir": "../dist-electron",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "../src/*"
      ],
      "@/types": [
        "../src/types/index.tsx"
      ],
      "@/types/*": [
        "../src/types/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "../premium/electron/**/*.ts",
    "../src/app/vite-env.d.ts"
  ],
  "exclude": [
    "db/seedDemo.ts",
    "db/test-db.ts"
  ]
}